# Copy to .env. Default: SSH access only, no public listener.
IDI_HTTP_PORT=8766
IDI_MEMORY_LIMIT=3g
IDI_PLATFORM_WRITE=0
# Set an existing domain before enabling the https profile.
IDI_DOMAIN=
# Change all four together if this subnet conflicts with a local network or VPN.
IDI_VPS_SUBNET=172.30.80.0/24
IDI_VPS_GATEWAY=172.30.80.1
IDI_VPS_APP_IP=172.30.80.10
IDI_VPS_PROXY_IP=172.30.80.20
